# Local development only. Runtime settings are configured in the hosting service.
# Use cloudflare-access on your own Cloudflare account; sites only on ChatGPT Sites.
ADMIN_AUTH_MODE=cloudflare-access
ADMIN_EMAIL=
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
# Used by npm run hosting:configure after building:
CLOUDFLARE_D1_DATABASE_ID=
CUSTOM_DOMAIN=
# Deployment credentials belong in your shell or GitHub Secrets, never source:
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
